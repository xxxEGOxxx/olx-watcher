{
  "name": "olx-watcher",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/index.ts",
    "start": "node src/index.ts",
    "once": "node --env-file-if-exists=.env src/index.ts --once",
    "test": "node --test 'test/**/*.test.ts'",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm test",
    "deploy:production": "bash ops/deploy/production.sh",
    "server": "bash ops/server.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  }
}
