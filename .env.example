# Скопируй в .env (локально) и в /opt/olx-watcher/.env (на сервере, chmod 600).
# Никогда не коммить .env.

# Токен бота от @BotFather.
TELEGRAM_BOT_TOKEN=CHANGE_ME
# Чат, куда слать объявления (свой user id: напиши боту @userinfobot).
TELEGRAM_CHAT_ID=CHANGE_ME

# Поиски OLX через `|`: полные URL страниц поиска с фильтрами.
OLX_SEARCH_URLS=https://www.olx.pl/nieruchomosci/mieszkania/wynajem/warszawa/
# Как получать объявления: none (только прогрев, ничего не качает) — см. docs/olx-access.md.
OLX_SOURCE=none

# Интервал опроса в минутах (не опрашивать OLX чаще 5 минут).
POLL_INTERVAL_MINUTES=10
# Часовой пояс для дат в сообщениях.
TZ=Europe/Warsaw
# Каталог для SQLite и heartbeat (в контейнере — volume /data).
DATA_DIR=./data
