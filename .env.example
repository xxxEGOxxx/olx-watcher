# Скопируй в .env (локально) и в /opt/olx-watcher/.env (сервер, chmod 600). Никогда не коммить
# .env*. Для otodom те же значения лежат в секретах GitHub Actions (см. README).

# Токен бота от @BotFather.
TELEGRAM_BOT_TOKEN=CHANGE_ME
# Чат, куда слать объявления (свой user id: напиши боту @userinfobot).
TELEGRAM_CHAT_ID=CHANGE_ME

# Поиски через `|`: URL страницы поиска OLX и/или otodom прямо из адресной строки, с фильтрами.
# Сортировка «сначала новые» ставится сама. Можно держать один и тот же список везде.
SEARCH_URLS=https://www.olx.pl/nieruchomosci/mieszkania/wynajem/poznan/?search%5Bfilter_float_price%3Ato%5D=3000|https://www.otodom.pl/pl/wyniki/wynajem/mieszkanie/wielkopolskie/poznan/poznan/poznan?priceMax=3000

# Какие сайты опрашивает ЭТОТ раннер (через запятую): olx, otodom.
# Сервер: olx (otodom блокирует IP сервера). otodom опрашивает GitHub Actions (SOURCES=otodom).
SOURCES=olx
# 1 = не слать с OLX копии объявлений otodom (их пришлёт GitHub Actions; иначе придут дважды).
SKIP_OTODOM_COPIES=1

# Интервал опроса в минутах (минимум 5).
POLL_INTERVAL_MINUTES=15
# Часовой пояс для дат в сообщениях.
TZ=Europe/Warsaw
# Каталог для SQLite и heartbeat (в контейнере — volume /data, в Actions — кэш).
DATA_DIR=./data
